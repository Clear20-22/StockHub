# ==============================================================================
# StockHub Enterprise System Environment Configuration Template
# Copy to .env (never commit .env). docker-compose.yml reads these values.
# ==============================================================================

# Backend API Endpoint (Used by Vite Frontend in development)
VITE_API_BASE_URL="http://localhost:8000"

# Application Environment
NODE_ENV="development"

# --- Docker Compose secrets ---
# Generate each key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=""
REFRESH_SECRET_KEY=""

# MongoDB root account created on first start (use letters and digits only,
# or URL-encode special characters, because it is placed in a connection URL)
MONGO_ROOT_USERNAME="stockhub"
MONGO_ROOT_PASSWORD=""

# Cloudinary (file uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
