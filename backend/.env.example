# ==============================================================================
# StockHub Enterprise Backend Environment Configuration Template
# ==============================================================================

# Application Meta
APP_NAME="StockHub API"
APP_VERSION="1.0.0"
ENVIRONMENT="development"  # development | staging | production
DEBUG=true

# Security Keys (CRITICAL: Generate strong random secrets for production)
SECRET_KEY="your-super-secret-jwt-key-change-this-in-production"
REFRESH_SECRET_KEY="your-super-secret-refresh-token-key-change-this-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connections
DATABASE_URL="sqlite:///./stockhub.db"
DB_ENGINE="sqlite"  # sqlite | mongodb

# MongoDB Configuration (Optional)
MONGODB_URL="mongodb://localhost:27017"
MONGODB_DB_NAME="stockhub"

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:5174"
